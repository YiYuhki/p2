# Copy to deploy/postfix.env and edit, then:
#   docker compose --env-file deploy/postfix.env -f deploy/docker-compose.postfix.yml up --build
#
# Everything below is optional; unset values fall back to the example.com demo.

# The mail domain this gateway serves. Mailboxes, accepted recipients, OTP/DLP
# From addresses and the DLP admin (security@<domain>) are all derived from it.
MAIL_DOMAIN=example.com

# Mailboxes to create, space-separated "localpart:password" pairs.
# Include security@<domain> so DLP admin notices have somewhere to go.
MAIL_USERS=alice:alicepass bob:bobpass security:securitypass

# Public URL the portal puts in the links it inserts into mail. Use the address
# recipients reach from their browser (behind TLS in production).
PORTAL_BASE_URL=http://localhost:8080

# Timezone for dates shown in banners / the portal.
MAIL_TIMEZONE=Asia/Seoul

# ---- TLS ----
# Turn TLS on for every endpoint (SMTP STARTTLS, portal HTTPS, IMAPS :993,
# submission STARTTLS :587, smtps :465). Default off (plaintext).
TLS_ENABLED=false
# selfsigned = openssl cert for local/internal testing (works offline).
# certbot    = real Let's Encrypt cert; needs the hostnames below to resolve to
#              this host and port 80 reachable from the Internet.
TLS_MODE=selfsigned
# Hostnames the certificate covers. Default: secmail.<domain>,mail.<domain>.
# Set PORTAL_BASE_URL's host to one of these when TLS is on.
TLS_HOSTNAMES=
# certbot only:
CERTBOT_EMAIL=
CERTBOT_STAGING=false

# Secrets — CHANGE THESE for anything beyond a local demo.
SECMAIL_SESSION_SECRET=demo-session-secret-change-me-0123456789
SECMAIL_INTERNAL_TOKEN=demo-internal-token-change-me
SECMAIL_ADMIN_TOKEN=demo-admin-token-change-me
S3_ACCESS_KEY=secmail
S3_SECRET_KEY=secmail-s3-secret
